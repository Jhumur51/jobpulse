# ==============================================================================
# JobPulse Backend Environment Configuration
# ==============================================================================

# Server Port and Environment
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection URL
# Format: postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# NOTE: If PostgreSQL is offline or uninstalled, the backend automatically activates
# a non-blocking in-memory fallback data store so you can evaluate the platform immediately.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobpulse?schema=public

# JSON Web Token (JWT) Security Secrets
JWT_SECRET=jobpulse_dev_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=jobpulse_dev_refresh_jwt_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Python Machine Learning Service Integration (FastAPI)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=15000

# Frontend Client URL (For CORS Whitelist)
CLIENT_URL=http://localhost:5173

# Dataset CSV Upload Limit (in Megabytes)
MAX_FILE_SIZE_MB=25
